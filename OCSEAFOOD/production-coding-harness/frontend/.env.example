# Server-side backend URL used by Next.js rewrites and server-rendered pages.
BACKEND_URL=http://localhost:5000

# Public website origin used for canonical/social metadata. Set this to the final HTTPS domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public OAuth client identifier. This value is embedded in the browser bundle.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
