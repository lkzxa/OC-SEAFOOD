# Copy this file to backend/.env. Never commit the real file.

# Core runtime
NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/ocseafood?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS

# Browser and generated-link origins
FRONTEND_URL=http://localhost:3000
# Required in production. Comma-separated full origins; wildcard is rejected.
CORS_ORIGIN=http://localhost:3000

# Health and shutdown deadlines in milliseconds
HEALTHCHECK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000

# Local final testing only. Production blocks Admin password login regardless.
ALLOW_ADMIN_PASSWORD_LOGIN=true

# Google OAuth for Admin login
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:3000/login

# Email notification fallback. Admin settings stored in PostgreSQL take priority.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=no-reply@ocseafood.vn
EMAIL_TO_ADMIN=

# Order notification fallback
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ZALO_OA_ACCESS_TOKEN=
ZALO_USER_ID=

# Recruitment notification fallback
RECRUITMENT_TELEGRAM_BOT_TOKEN=
RECRUITMENT_TELEGRAM_CHAT_ID=

# Notification worker
NOTIFICATION_WORKER_INTERVAL_MS=10000
MAX_NOTIFICATION_RETRIES=5

# Persistent media. Development defaults to backend/uploads when MEDIA_ROOT is blank.
# Production with MEDIA_PROVIDER=local requires an absolute persistent directory.
MEDIA_PROVIDER=local
MEDIA_ROOT=

# Optional alternative media provider
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
