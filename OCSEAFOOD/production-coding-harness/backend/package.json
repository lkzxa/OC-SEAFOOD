{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node src/server.js",
    "start": "node src/server.js",
    "build": "node --check src/server.js && node --check src/app.js",
    "lint": "node --check src/server.js && node --check src/app.js && node --check src/config/env.js && node --check src/constants/orderStatus.js && node --check src/routes/orders.js && node --check src/routes/settings.js && node --check src/workers/notificationWorker.js && node --check src/utils/seed.js && node --check create-admin.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "admin:create": "node create-admin.js",
    "media:inventory": "node scripts/media-inventory.js",
    "media:inventory:strict": "node scripts/media-inventory.js --strict",
    "media:backup": "node scripts/media-backup.js create",
    "media:verify-backup": "node scripts/media-backup.js verify",
    "content:import-reviewed": "node scripts/import-reviewed-posts.js --apply"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "5.2.1",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.3.0",
    "nodemailer": "10.0.3",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "prisma": "^5.15.0",
    "supertest": "^7.0.0"
  }
}
